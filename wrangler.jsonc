{
  "name": "pubnamestats",
  "compatibility_date": "2026-11-01",
  // Wrangler runs this before every deploy, so no dashboard build command is needed.
  "build": {
    "command": "python3 build.py"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
